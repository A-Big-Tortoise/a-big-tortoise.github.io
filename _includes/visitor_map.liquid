<!--
  Visitor map widget.

  Paste your embed snippet from a visitor-map service between the two
  comment markers below, then rebuild the site. Leave it empty to hide.

  Recommended: MapMyVisitors (the spinning 3D globe; works on GitHub Pages)
    1. Go to https://mapmyvisitors.com/ and sign up (free, no card)
    2. Choose the "3D Globe Widget" style
    3. Copy the embed snippet it gives you
    4. Paste it below, between the BEGIN/END markers

  Also works with any other widget (Flag Counter, etc.) — just paste its snippet.
-->

<!-- BEGIN visitor map snippet -->
{% if include.hidden %}
  <div class="visitor-map-tracker" aria-hidden="true" style="display: none !important;">
{% endif %}
<div class="mapmyvisitors-container"></div>
<script>
  (function () {
    var container = document.currentScript.previousElementSibling;
    var now = new Date();
    var today =
      now.getFullYear() +
      "-" +
      String(now.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(now.getDate()).padStart(2, "0");
    var storageKey = "mapmyvisitors-loaded-" + today;
    var shouldLoad = true;

    try {
      if (window.localStorage.getItem(storageKey)) {
        shouldLoad = false;
      } else {
        window.localStorage.setItem(storageKey, "true");
      }
    } catch (error) {
      // If localStorage is unavailable, still load the widget.
    }

    if (!shouldLoad) {
      return;
    }

    var script = document.createElement("script");
    script.type = "text/javascript";
    script.id = "mapmyvisitors";
    script.src = "https://mapmyvisitors.com/map.js?d=1teBlh-fHloJFfSGloahdflu6klDG2kZCaXGzUfuf5M&cl=ffffff&w=a";
    container.appendChild(script);
  })();
</script>
{% if include.hidden %}
  </div>
{% endif %}
<!-- END visitor map snippet -->
